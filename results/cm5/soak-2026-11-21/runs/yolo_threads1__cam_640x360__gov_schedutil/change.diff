-  # omitted here so the value is not frozen into the seeded
-  # ~/.dexi-config.yaml; set nodes.servo.enabled in
-  # dexi_config_<platform>.yaml. Same reasoning as gpio above.
-  # Object detection. Change to true and restart dexi.service to turn it on.
