-# DEXI Shared Configuration (base)
-#
-# This file holds values that are identical across all DEXI hardware
-# platforms. Per-platform overrides (e.g. camera resolution on Pi 5 vs
-# CM4/CM5) live in dexi_config_<platform>.yaml next to this file.
-#
-# At runtime, scripts/start.bash detects the platform and looks up each
-# parameter in this order:
-#   1. ~/.dexi-config.yaml              (user override, optional)
-#   2. dexi_config_<platform>.yaml      (per-platform overlay)
-#   3. dexi_config.yaml                 (this file — shared base)
-#   4. hardcoded default in start.bash
-#
-# Copy this file (or the matching dexi_config_<platform>.yaml) to
-# /home/dexi/.dexi-config.yaml to customize.
-
 nodes:
   apriltag:
     enabled: true
-  # tag_nav (AprilTag navigation behind /dexi/tag_nav/command, from dexi_apriltag)
-  # is per airframe: the config file carries the camera mount offset. It is
-  # intentionally omitted here so the value is not frozen into the seeded
-  # ~/.dexi-config.yaml, where it would override the DEXI 5 platform configs that
-  # turn it on. Same reasoning as gpio below. start.bash defaults to off.
-  # telemetry (/dexi/telemetry, a 2 Hz JSON summary for dashboards) is on unless
-  # nodes.telemetry.enabled is false.
   camera:
     enabled: true
-    format: "XRGB8888"
+    format: XRGB8888
     jpeg_quality: 60
-    # width / height live in dexi_config_<platform>.yaml because they
-    # depend on the camera hardware attached to each platform.
-  # gpio (TCA9555 expander) is platform-specific: present on some carriers,
-  # absent on others (e.g. CM5). It is intentionally omitted here so the
-  # value isn't frozen into the seeded ~/.dexi-config.yaml; set
-  # nodes.gpio.enabled in dexi_config_<platform>.yaml. start.bash defaults
-  # to true when unset, preserving behavior on carriers that have the chip.
+    width: 640
+    height: 360
   offboard:
     enabled: true
     keyboard_control: false
   rosbridge:
     enabled: true
-  # servo (PCA9685) is platform-specific: the chip is on the DroneBlocks
